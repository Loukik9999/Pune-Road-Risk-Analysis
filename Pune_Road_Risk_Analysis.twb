    <worksheet name='KPI 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Arial' fontsize='12'>KPI</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pune_tableau_ready' name='federated.03cets61m7vwl710uce9f0pkab16' />
          </datasources>
          <datasource-dependencies datasource='federated.03cets61m7vwl710uce9f0pkab16'>
            <column caption='Festival Accident' datatype='integer' name='[Calculation_0369442429202433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [festival] != &quot;No Festival&quot; THEN [accident_id] END' />
            </column>
            <column caption='Weekend Count' datatype='integer' name='[Calculation_0369442443284485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Weekend Label] = &apos;Weekend&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Weekend Accident Percentage' datatype='real' name='[Calculation_0369442445557766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Calculation_0369442443284485])/COUNT([accident_id])*100,2)' />
            </column>
            <column caption='Weekday Count' datatype='integer' name='[Calculation_0369442446831623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Weekend Label] = &apos;Weekday&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Weekday Accident Percentage' datatype='real' name='[Calculation_0369442448412680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Calculation_0369442446831623])/COUNT([accident_id])*100,2)' />
            </column>
            <column caption='Night Accident Count' datatype='integer' name='[Calculation_0369442451578889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [hour] &gt;= 18 OR [hour] &lt;= 5 THEN [accident_id] END )' />
            </column>
            <column caption='Month Name' datatype='string' name='[Calculation_1070380968529920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[date])' />
            </column>
            <column datatype='string' name='[Weekend Label]' role='dimension' type='nominal' />
            <column caption='Accident Id' datatype='integer' name='[accident_id]' role='dimension' type='ordinal' />
